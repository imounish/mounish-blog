---
// T6: port of src/components/tags/TagsArray.jsx.
interface Props {
  tags: { title: string; slug: { current: string } }[];
  class?: string;
}
const { tags, class: className } = Astro.props;
---

<ul class={className}>
  {
    tags.map((tag) => (
      <li>
        <a
          href={`/tags/?search=${tag.slug.current}`}
          title={tag.title}
          class="font-worksans rounded-md bg-gray-700 px-2 py-1.5 text-sm font-light uppercase text-gray-200 hover:bg-gray-900 dark:bg-gray-400 dark:text-black dark:hover:bg-gray-200"
        >
          {tag.title}
        </a>
      </li>
    ))
  }
</ul>
