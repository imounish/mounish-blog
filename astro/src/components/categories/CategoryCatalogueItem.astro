---
// T6: sub-component of CategoryCatalogue.astro — ports CustomBlogItem() from
// src/components/categories/CategoryCatalogue.jsx. The current post is
// filtered out of the list before this is rendered (see
// CategoryCatalogue.astro), so the "disabled" self-referencing state from
// the Gatsby version doesn't apply here.
import { buildSanityImageUrl } from '../../lib/sanityImage';
import type { CategoryCatalogueBlog } from '../../lib/sanity';

interface Props {
  blog: CategoryCatalogueBlog;
  categoryTitle: string;
}
const { blog, categoryTitle } = Astro.props;
const image = buildSanityImageUrl(blog.coverImage.asset, { width: 400 });
---

<div class="font-worksans">
  <a href={`/posts/${blog.slug.current}/`} title={blog.title}>
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={blog.coverImage.alt || ''}
      loading="lazy"
      class="blog-catalogue-image block h-auto w-full scale-100 rounded-md transition-transform duration-300 ease-in-out hover:scale-105"
    />
    <h2
      class="font-lora w-full pb-1 pt-2 text-base font-normal text-gray-800 no-underline dark:text-gray-200 xl:text-lg"
    >
      <span
        class="font-warnockdisp pr-2 text-sm font-light text-gray-800 no-underline dark:text-gray-200 xl:text-base"
      >
        {categoryTitle}
      </span>
      {blog.title}
    </h2>
  </a>
</div>

<style>
  .blog-catalogue-image {
    height: 136px;
  }
  @media only screen and (min-width: 960px) {
    .blog-catalogue-image {
      height: 160px;
    }
  }
  @media only screen and (min-width: 1140px) {
    .blog-catalogue-image {
      height: 180px;
    }
  }
</style>
