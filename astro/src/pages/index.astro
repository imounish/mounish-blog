---
// T9: the homepage — Astro equivalent of src/pages/index.jsx, composed from
// the ported FeaturedBlogs/FeaturedCategories/NewsletterSection components.
//
// Not ported: `HeroSection` (src/components/homepage/HeroSection.jsx) — it's
// a stub in the Gatsby app (`<div>HeroSection</div>`) that index.jsx never
// actually imports/renders, so there's nothing to port.
import Layout from '../layouts/Layout.astro';
import Container from '../components/partials/Container.astro';
import MarginedContainer from '../components/partials/MarginedContainer.astro';
import Break from '../components/partials/Break.astro';
import ScrollToTop from '../components/partials/ScrollToTop.astro';
import FeaturedBlogs from '../components/homepage/FeaturedBlogs.astro';
import FeaturedCategories from '../components/homepage/FeaturedCategories.astro';
import NewsletterSection from '../components/homepage/NewsletterSection.astro';
import { getFeaturedContent } from '../lib/sanity';

const featured = await getFeaturedContent();
const featuredBlogs = featured?.blogs ?? [];
const featuredCategories = featured?.categories ?? [];
---

<Layout>
  <Container>
    <MarginedContainer>
      <ScrollToTop showBelow={500} />
      <FeaturedBlogs blogs={featuredBlogs} />
      <Break />
      <FeaturedCategories categories={featuredCategories} />
      <Break />
      <NewsletterSection class="pb-8" heading="stay in touch?" />
    </MarginedContainer>
  </Container>
</Layout>
